# Run Gradio on the same computer as llama.cpp for these defaults.
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=ornith-ai/Ornith-1.5-9B-GGUF:Q4_K_M
# Local-mode placeholder; no OpenAI account is required for the defaults.
LLAMA_API_KEY=local-not-needed

# Hosted provider URL/model/key are entered under Connection in Gradio.
# UI profiles are session-only and do not overwrite these local defaults.

# Allow time for --models-autoload to load the model on the first request.
LLAMA_TIMEOUT_SECONDS=180
# Includes any reasoning tokens. Other sampling defaults stay in models.ini.
LLAMA_MAX_TOKENS=4096
# One recovery attempt before any tool executes, if generation is truncated.
LLAMA_RECOVERY_MAX_TOKENS=6144
# Optional served context-window override (defaults to /props n_ctx or conservative 16384).
# LLAMA_CTX_SIZE=16384
# Assistant scope: domain (BRAMS / radio-meteor science only) or general.
ASSISTANT_SCOPE=domain
# Production per-message budgets, including retries. Benchmark JSON has its own protocol.
LLAMA_REQUEST_LIMIT=6
LLAMA_TOOL_CALL_LIMIT=6

# Optional CLI benchmark credential; choose the provider/model in benchmarks/models.json.
# BENCHMARK_PUBLIC_API_KEY=

GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# Local meteor detector (optional overrides).
VISION_MODEL_PATH=models/yolo11n_brams.onnx
VISION_CONF_THRESHOLD=0.25
VISION_IOU_THRESHOLD=0.45
VISION_INPUT_SOURCE=auto
